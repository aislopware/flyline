# aislopware's flyline (https://github.com/aislopware/flyline), a standalone continuation of
# HalFrgrd/flyline. Installs the prebuilt library from the GitHub release; Intel Macs, which have
# no release binary, build from source, as does `brew install --HEAD aislopware/tap/flyline`.
# Shares the name with homebrew-core's `flyline`, which installs the same lib/bash/flyline file —
# uninstall that one first.
#
# Generated by flyline's release workflow from packaging/homebrew/flyline.rb.in: edit it there.
class Flyline < Formula
  desc "Bash plugin that replaces readline: highlighting, autosuggestions, fuzzy history"
  homepage "https://github.com/aislopware/flyline"
  license any_of: ["GPL-3.0-only", "MIT"]

  head do
    url "https://github.com/aislopware/flyline.git", branch: "master"
    depends_on "rust" => :build
  end

  depends_on "bash" => :test

  on_macos do
    on_arm do
      url "https://github.com/aislopware/flyline/releases/download/v@VERSION@/libflyline-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/aislopware/flyline/archive/refs/tags/v@VERSION@.tar.gz"
      sha256 "@SHA256_SOURCE@"
      depends_on "rust" => :build
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/aislopware/flyline/releases/download/v@VERSION@/libflyline-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/aislopware/flyline/releases/download/v@VERSION@/libflyline-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    # A release archive holds one file, libflyline.{dylib,so}.<version>; a source tree has none.
    prebuilt = Dir["libflyline.*"]
    if prebuilt.empty?
      cargo_args = std_cargo_args.reject { |arg| arg["--root"] || arg["--path"] }
      system "cargo", "build", "--lib", "--release", *cargo_args
      (lib/"bash").install shared_library("target/release/libflyline") => "flyline"
    else
      (lib/"bash").install prebuilt.first => "flyline"
    end
  end

  def caveats
    <<~EOS
      Load it from an interactive Homebrew bash (macOS's /bin/bash 3.2 cannot load builtins):
        enable -f #{HOMEBREW_PREFIX}/lib/bash/flyline flyline
    EOS
  end

  test do
    require "io/console"
    require "pty"

    output_log = testpath/"output.log"
    PTY.spawn(formula_opt_bin("bash")/"bash", "--noprofile", "--norc", "-i",
              [:out, :err] => output_log.to_s) do |r, w, pid|
      r.winsize = [80, 130]
      w.puts "enable -f #{lib}/bash/flyline flyline"
      w.puts "flyline version"
      w.puts "exit"
      r.read
    rescue Errno::EIO
      # GNU/Linux raises EIO when read is done on closed pty
    ensure
      r.close
      w.close
      Process.wait(pid)
    end

    assert_match version.to_s, output_log.read
  end
end
